<?xml version="1.0" encoding="utf-8" ?>
    
<ContentPage
    x:Class="Location_Tracker.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False">

    <!--
        MainView uses a two-row layout:
        the top row contains the application header,
        and the remaining space is reserved for the map.
    -->
    <Grid RowDefinitions="64,*">

        <!-- Application header styled to match the professor's reference layout. -->
        <Grid
            Grid.Row="0"
            BackgroundColor="#512BD4"
            Padding="16,0">

            <Label
                Text="MainView"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="White"
                VerticalOptions="Center" />

        </Grid>

        <!--
            The map will be added to this container during the Maps Integration
            increment. Keeping the container separate keeps the UI and map logic
            organized.
        -->
        <Grid
            x:Name="MapContainer"
            Grid.Row="1"
            BackgroundColor="White" />

    </Grid>

</ContentPage>