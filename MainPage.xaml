<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Location_Tracker.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="64,*,44,44,72">

        <!-- Application header -->
        <Grid
            Grid.Row="0"
            BackgroundColor="#512BD4"
            Padding="16,0">

            <Label
                Text="MainView"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="White"
                VerticalOptions="Center" />

        </Grid>

        <!-- Android and other supported platforms use the map -->
        <maps:Map
            x:Name="LocationMap"
            Grid.Row="1"
            IsShowingUser="True"
            IsVisible="{OnPlatform WinUI=False, Default=True}" />

        <!-- Windows uses a saved-location history list -->
        <Grid
            Grid.Row="1"
            RowDefinitions="44,*"
            BackgroundColor="White"
            IsVisible="{OnPlatform WinUI=True, Default=False}">

            <Label
                Grid.Row="0"
                Text="Saved Location History"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="Black"
                Padding="16,10"
                VerticalOptions="Center" />

            <CollectionView
                x:Name="LocationHistoryList"
                Grid.Row="1">

                <CollectionView.EmptyView>
                    <Label
                        Text="No saved location history yet."
                        FontSize="16"
                        TextColor="Gray"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Margin="20" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Frame
                            Margin="12,6"
                            Padding="12"
                            BorderColor="#D0D0D0"
                            CornerRadius="8"
                            HasShadow="False">

                            <VerticalStackLayout Spacing="4">

                                <Label
                                    Text="{Binding Timestamp, StringFormat='{}{0:MM/dd/yyyy h:mm:ss tt}'}"
                                    FontAttributes="Bold"
                                    TextColor="Black" />

                                <Label
                                    Text="{Binding Latitude, StringFormat='Latitude: {0:F6}'}"
                                    TextColor="Black" />

                                <Label
                                    Text="{Binding Longitude, StringFormat='Longitude: {0:F6}'}"
                                    TextColor="Black" />

                            </VerticalStackLayout>

                        </Frame>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

        <!-- Displays the most recent/current position -->
        <Grid
            Grid.Row="2"
            BackgroundColor="White"
            Padding="16,4">

            <Label
                x:Name="CurrentPositionLabel"
                Text="Current Position: Not available"
                FontSize="15"
                TextColor="Black"
                VerticalOptions="Center" />

        </Grid>

        <!-- Displays total distance -->
        <Grid
            Grid.Row="3"
            BackgroundColor="White"
            Padding="16,4">

            <Label
                x:Name="DistanceLabel"
                Text="Total Distance: 0.00 mi"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="Black"
                VerticalOptions="Center" />

        </Grid>

        <!-- Start and Stop tracking controls -->
        <Grid
            Grid.Row="4"
            ColumnDefinitions="*,*"
            ColumnSpacing="12"
            Padding="16,10"
            BackgroundColor="White">

            <Button
                x:Name="StartTrackingButton"
                Grid.Column="0"
                Text="Start Tracking"
                Clicked="OnStartTrackingClicked" />

            <Button
                x:Name="StopTrackingButton"
                Grid.Column="1"
                Text="Stop Tracking"
                Clicked="OnStopTrackingClicked"
                IsEnabled="False" />

        </Grid>

    </Grid>

</ContentPage>