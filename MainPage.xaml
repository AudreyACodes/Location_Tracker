<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Location_Tracker.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="64,*">

        <!-- Application header styled to match the professor's reference layout. -->
        <Grid
            Grid.Row="0"
            BackgroundColor="#512BD4"
            Padding="16,0">

            <Label
                Text="MainView"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="White"
                VerticalOptions="Center" />

        </Grid>

        <!-- Displays the .NET MAUI map and the user's current location. -->
        <maps:Map
            x:Name="LocationMap"
            Grid.Row="1"
            IsShowingUser="True" />

    </Grid>

</ContentPage>